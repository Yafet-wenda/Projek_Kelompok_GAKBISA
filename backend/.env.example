# Salin menjadi .env lalu isi nilai sebenarnya. JANGAN commit file .env.
# Cara pakai (Git Bash): cp .env.example .env
#
# KEPUTUSAN TIM: database produksi Supabase diurusi Haudajun Nando.
# Sementara backend jalan memakai PostgreSQL lokal (Opsi B di bagian bawah),
# lalu tinggal ganti blok DATABASE ke nilai Supabase (Opsi A) tanpa mengubah kode.
#
# Cara mengambil nilai Supabase dari dashboard:
#   1) https://supabase.com/dashboard  -> pilih project
#   2) Project Settings -> Database -> "Connection string" -> tab "URI" (pakai yang pooled/session pooler)
#      Dari string itu ambil 3 bagian:
#        - host  : contoh aws-0-ap-southeast-1.pooler.supabase.com  (REGION asli, bukan kata REGION)
#        - user  : contoh postgres.abcdwxyefz  (SELURUHNYA dipakai sebagai DB_USERNAME)
#        - password: DB_PASSWORD yang diset waktu membuat project
#   3) Project Settings -> API -> "Project URL" -> SUPABASE_URL
#   4) Project Settings -> API -> "service_role" secret -> SUPABASE_SERVICE_KEY
#      (kunci ini tidak boleh masuk ke frontend / dibagikan ke browser)

# --- Opsi A: Supabase (target akhir) ---
DB_HOST=<host-database-supabase>
DB_PORT=5432
DB_NAME=postgres
DB_USERNAME=postgres
DB_PASSWORD=GANTI_DENGAN_DB_PASSWORD
# require = koneksi dienkripsi (wajib untuk Supabase). Untuk lokal: disable.
DB_SSL_MODE=require

# --- Supabase Storage (Project Settings -> API) ---
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_KEY=GANTI_DENGAN_SERVICE_ROLE_KEY
STORAGE_BUCKET=portfolio-files

# Batas unggah portofolio
MAX_FILE_SIZE_BYTES=10485760
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,application/pdf

# Buat akun & data demo saat start (matikan sebelum demo/presentasi)
SEED_DATA=true

# ============================================================
# Opsi B: PostgreSQL lokal (pakai blok ini untuk develop harian)
# Setup sekali: jalankan .\setup-local-db.ps1 (bikin database "gakbisa"
# + simpan password ke .env). Upload portofolio belum aktif karena
# butuh kunci Supabase; login, matching, barter, sesi, ulasan,
# dan notifikasi berjalan penuh.
#   DB_HOST=localhost
#   DB_PORT=5432
#   DB_NAME=gakbisa
#   DB_USERNAME=postgres
#   DB_PASSWORD=<password waktu install PostgreSQL>
#   DB_SSL_MODE=disable
#   SUPABASE_URL=
#   SUPABASE_SERVICE_KEY=
# ============================================================
